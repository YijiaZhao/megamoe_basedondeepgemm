+# ==============================================================================
+"""SM120 (RTX PRO 6000 / 6000D) Mega-MoE for decode: MXFP4 experts x MXFP8 activations.
+
+With SGLANG_SM120_MEGA_MOE=1 and SGLANG_SHARED_EXPERT_TP1=1, attention DP and MoE EP over the FlashInfer CUTLASS
+MXFP4 backend (--moe-a2a-backend none --moe-runner-backend flashinfer_mxfp4), a
+MoE call whose largest per-rank token count is at most
+SGLANG_OPT_DEEPGEMM_MEGA_MOE_NUM_MAX_TOKENS_PER_RANK runs `fp4_mega_moe_sm120`
+(megamoe_basedondeepgemm, format 'w4a8_rm') on this rank's tokens: one persistent
+kernel that quantizes them, pushes them over PCIe P2P to the experts' ranks, runs
+FC1 + SwiGLU + FC2 there and combines the partials back here. Larger calls take
+the configured path. The kernel reads the FP4 weights FlashInfer holds (the
+checkpoint's row-major layout) and keeps its own copy of the UE8M0 scales. With SGLANG_SM120_MEGA_MOE_PACKED=1 the main
+model's weights move to the kernel's packed 'w4a8' layout at load (in place, ~12% faster decode MoE); FlashInfer's
+calls then read a layer's row-major weights rebuilt into one shared scratch buffer (~1.4 ms per layer). With SGLANG_SM120_CAKE_PREFILL=1 the main model's
+larger calls (up to SGLANG_SM120_CAKE_MAX_TOKENS per rank) run FlashInfer's Cake SM120 MegaMoE instead (the moe_ep
+backend sm120_mxfp4_mxfp8_bf16_cake; needs FlashInfer main): its W2 is FlashInfer's, its interleaved W13 is rebuilt
+per call into one shared scratch buffer and its scales are copied at load. The
+module `deep_gemm/mega/sm120_fp4.py` is loaded by path from
+SGLANG_SM120_MEGA_MOE_DIR (a megamoe_basedondeepgemm checkout); its torch
+extension builds on first use.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import logging
+import os
+import sys
+from typing import Optional
+
+import torch
+
+from sglang.srt.environ import envs
+
+logger = logging.getLogger(__name__)
+
+_FMT = "w4a8_rm"
+_PACKED_FMT = "w4a8"
+_SCRATCH: dict = {}  # (W13 shape, W2 shape) -> row-major scratch for FlashInfer's calls on packed layers
+_LOGGED = set()
+_SLOTS: dict = {}  # (experts, top-k) -> buffer slot, in build order (the main model, then a draft model's MoE)
+_MODULE = None
+_BUFFER: dict = {}
+_CAKE: dict = {}  # "layer": the Cake MoEEpLayer (one workspace for all layers), W13 shape -> interleaved scratch
+
+
+def _cake_enabled() -> bool:
+    return os.environ.get("SGLANG_SM120_CAKE_PREFILL", "0") == "1"
+
+
+def _cake_all() -> bool:
+    return os.environ.get("SGLANG_SM120_CAKE_ALL", "0") == "1"
+
+
+def _cake_max_tokens() -> int:
+    return int(os.environ.get("SGLANG_SM120_CAKE_MAX_TOKENS", "16384"))
+
+
+def _build_cake_weights(experts, s13: torch.Tensor, s2: torch.Tensor, w13_up_first: bool) -> None:
+    """Cake's kernel-layout weights of this layer: W2 is FlashInfer's (same row-major bytes), W1 (gate/up rows
+    interleaved by 8) a shared scratch filled per call, the scales a packed copy made now."""
+    from flashinfer.moe_ep.backends.mega.kernel.sm120.mxfp4_mxfp8_bf16_cake import cake_weights as cw
+
+    w13, w2 = experts.w13_weight.data.view(torch.uint8), experts.w2_weight.data.view(torch.uint8)
+    L, H, I = w13.shape[0], w2.shape[1], w2.shape[2] * 2
+    perm = cw.gate_up_interleave_index(I).to(w13.device)  # rows of [gate; up]
+    if w13_up_first:
+        perm = (perm + I) % (2 * I)
+    key = tuple(w13.shape)
+    if _cake_all():  # Cake serves every call: interleave W13 once, in place
+        w13.copy_(w13.index_select(1, perm))
+    elif key not in _CAKE:
+        _CAKE[key] = torch.empty_like(w13)
+    w1_sf = cw.pack_scales_kblock_major(s13.index_select(1, perm))
+    w2_sf = cw.pack_scales_kblock_major(s2)
+    w1_b8, w2_b8 = cw._noshared_operands(w13.device, H, I)
+    filler = torch.tensor(cw.NOSHARED_SCALE_FILL_WORD, dtype=torch.int64).to(torch.int32)
+    w1_shared_sf = filler.expand(H // 128, 2 * I).to(w13.device).contiguous().view(torch.uint32)
+    w2_shared_sf = filler.expand(I // 128, H).to(w13.device).contiguous().view(torch.uint32)
+    tw = cw.TransformedCakeMegaWeights(
+        w1_fp4=w13 if _cake_all() else _CAKE[key],
+        w1_sfb=cw.scale_vector_layout(torch.cat([w1_sf, w1_shared_sf], dim=0)),
+        w2_fp4=w2,
+        w2_sfb=cw.scale_vector_layout(torch.cat([w2_sf, w2_shared_sf], dim=0)),
+        w1_b8=w1_b8,
+        w2_b8=w2_b8,
+        hidden_size=H,
+        intermediate_size=I,
+        local_experts=L,
+        has_shared_expert=False,
+    )
+    experts.mega_sm120_cake = (tw, perm)
+
+
+def _cake_layer(ep_group, tw, num_experts: int, top_k: int):
+    layer = _CAKE.get("layer")
+    if layer is None:
+        import torch.distributed as dist
+        from flashinfer.moe_ep import BootstrapConfig, FleetParams, MegaConfig, MoEEpLayer
+        from flashinfer.moe_ep.backends.mega.kernel.sm120.mxfp4_mxfp8_bf16_cake.cake_config import (
+            Sm120_Mxfp4_Mxfp8_Bf16_Cake_MegaMoeConfig,
+        )
+
+        table = os.environ.get("SGLANG_SM120_CAKE_TABLE", "all_gin")
+        logger.info("SM120 Cake MegaMoE: EP%d, %d experts / top-%d, %d tokens per rank, table %s",
+                    dist.get_world_size(ep_group), num_experts, top_k, _cake_max_tokens(), table)
+        layer = MoEEpLayer(
+            bootstrap=BootstrapConfig(world_size=dist.get_world_size(ep_group), rank=dist.get_rank(ep_group),
+                                      device=torch.cuda.current_device(), process_group=ep_group),
+            fleet_params=FleetParams(num_experts=num_experts, max_tokens_per_rank=_cake_max_tokens(),
+                                     token_hidden_size=tw.hidden_size),
+            weights=None,
+            backend=MegaConfig(
+                megakernel=Sm120_Mxfp4_Mxfp8_Bf16_Cake_MegaMoeConfig(
+                    intermediate_size=tw.intermediate_size, top_k=top_k, swiglu_limit=10, transport_table=table),
+                quantize_input=True,
+                transformed_weights=tw,
+            ),
+        )
+        _CAKE["layer"] = layer
+    layer._transformed = tw  # one workspace, this layer's weights (descriptors cached per weights object)
+    return layer
+
+
+def _run_cake(experts, hidden_states, topk_ids, topk_weights, ep_group, num_tokens, top_k):
+    from flashinfer.moe_ep import MoEEpTensors
+
+    tw, perm = experts.mega_sm120_cake
+    if not _cake_all():
+        torch.index_select(experts.w13_weight.data.view(torch.uint8), 1, perm, out=tw.w1_fp4)
+    layer = _cake_layer(ep_group, tw, experts.num_experts, top_k)
+    n = max(num_tokens, 1)  # a rank without tokens still joins the collective call, with one unrouted row
+    if num_tokens == 0:
+        hs = hidden_states.new_zeros((1, tw.hidden_size))
+        ids = torch.full((1, top_k), -1, dtype=torch.int64, device=hidden_states.device)
+        w = torch.zeros((1, top_k), dtype=torch.float32, device=hidden_states.device)
+    else:
+        hs = hidden_states[:num_tokens].contiguous()
+        ids = topk_ids[:num_tokens].to(torch.int64).contiguous()
+        w = topk_weights[:num_tokens].float().contiguous()
+    y = torch.empty((n, tw.hidden_size), dtype=torch.bfloat16, device=hidden_states.device)
+    from sglang.srt.model_executor.runner import get_is_capture_mode
+
+    if get_is_capture_mode():  # rank-uniform bucket: no routing all-gather, no host sync
+        layer.stage_inputs(MoEEpTensors(hidden_states=hs, topk_ids=ids, topk_weights=w), compile_tokens_per_rank=n)
+        layer.compute_staged(output=y)
+    else:
+        layer(MoEEpTensors(hidden_states=hs, topk_ids=ids, topk_weights=w, output=y))
+    return y[:num_tokens]
+
+
+def sm120_mega_moe_enabled() -> bool:
+    return os.environ.get("SGLANG_SM120_MEGA_MOE", "0") == "1"
+
+
+def sm120_fp4():
+    global _MODULE
+    if _MODULE is None:
+        root = os.environ.get("SGLANG_SM120_MEGA_MOE_DIR", "/opt/sm120_megamoe")
+        path = os.path.join(root, "deep_gemm", "mega", "sm120_fp4.py")
+        spec = importlib.util.spec_from_file_location("sm120_fp4", path)
+        module = importlib.util.module_from_spec(spec)
+        sys.modules["sm120_fp4"] = module  # sm120_fp4_relayout imports it by this name
+        spec.loader.exec_module(module)
+        _MODULE = module
+    return _MODULE
+
+
+def _relayout():
+    root = os.environ.get("SGLANG_SM120_MEGA_MOE_DIR", "/opt/sm120_megamoe")
+    if "sm120_fp4_relayout" not in sys.modules:
+        sm120_fp4()
+        spec = importlib.util.spec_from_file_location(
+            "sm120_fp4_relayout", os.path.join(root, "deep_gemm", "mega", "sm120_fp4_relayout.py")
+        )
+        module = importlib.util.module_from_spec(spec)
+        sys.modules["sm120_fp4_relayout"] = module
+        spec.loader.exec_module(module)
+    return sys.modules["sm120_fp4_relayout"]
+
+
+def sm120_fused_router(moe) -> bool:
+    """SGLANG_SM120_FUSED_ROUTER=1: the kernel routes from the gate logits itself (DeepSeek-V4.1's router: sqrtsoftplus
+    via log1p, correction bias, top-k, renormalize, routed scaling, EPLB 'dynamic'), replacing moe_fused_gate and the
+    EPLB remap. Not for hash layers, fused shared experts, Cake layers or more than 384 experts."""
+    if os.environ.get("SGLANG_SM120_FUSED_ROUTER", "0") != "1" or getattr(moe, "is_hash", False):
+        return False
+    cfg = getattr(getattr(moe, "topk", None), "topk_config", None)
+    return (
+        cfg is not None
+        and cfg.scoring_func == "sqrtsoftplus"
+        and getattr(cfg, "sqrtsoftplus_log1p", False)
+        and getattr(moe, "num_fused_shared_experts", 0) == 0
+        and getattr(moe.experts, "mega_sm120_cake", None) is None
+        and moe.config.n_routed_experts <= 384
+        and moe.gate.e_score_correction_bias is not None
+    )
+
+
+def sm120_router_args(moe, router_logits, input_ids, dispatch_info) -> dict:
+    """The in-kernel router's arguments for this layer, as vision_topk / TopK would route: bias_vl for image tokens
+    (renormalize + 1e-20), else the zero-sum guard; EPLB: the layer's replicas (int32, cached on the layer)."""
+    cfg = moe.topk.topk_config
+    bias_vl = getattr(moe.gate, "e_score_correction_bias_vl", None)
+    l2p = None
+    if dispatch_info is not None:
+        l2p = getattr(moe, "_sm120_l2p", None)
+        if l2p is None:
+            l2p = dispatch_info.partial_logical_to_all_physical_map.to(torch.int32).contiguous()
+            moe._sm120_l2p = l2p
+    return dict(
+        router_logits=router_logits,
+        router_bias=moe.gate.e_score_correction_bias,
+        router_bias_alt=bias_vl if input_ids is not None else None,
+        input_ids=input_ids if bias_vl is not None else None,
+        alt_token_id=int(getattr(moe.config, "image_token_id", -1) or -1),
+        logical_to_all_physical=l2p,
+        renormalize=bool(cfg.renormalize and cfg.top_k > 1),
+        renormalize_epsilon=1e-20 if bias_vl is not None else 0.0,
+        apply_routed_scaling=bool(cfg.apply_routed_scaling_factor_on_output),
+        routed_scaling_factor=float(cfg.routed_scaling_factor or 1.0),
+    )
+
+
+def _max_tokens_per_rank() -> int:
+    return envs.SGLANG_OPT_DEEPGEMM_MEGA_MOE_NUM_MAX_TOKENS_PER_RANK.get()
+
+
+def use_sm120_mega_moe(moe, hidden_states: torch.Tensor) -> bool:
+    """Rank-uniform: every rank sees the same per-rank token counts (or, in CUDA graph capture, the same padded
+    batch)."""
+    if not sm120_mega_moe_enabled() or not getattr(moe.experts, "_mega_moe_weights_built", False):
+        return False
+    if getattr(moe, "num_fused_shared_experts", 0) != 0:  # the kernel routes only the routed experts
+        return False
+    # the shared expert runs on this rank's tokens only: it must be whole here (SGLANG_SHARED_EXPERT_TP1=1), not a TP
+    # shard summed over the ranks
+    if getattr(moe, "shared_experts", None) is not None and not getattr(moe, "_shared_expert_tp1", False):
+        return False
+    from sglang.srt.layers.dp_attention import get_dp_global_num_tokens
+    from sglang.srt.model_executor.runner import get_is_capture_mode
+
+    if get_is_capture_mode():
+        use = hidden_states.shape[0] <= _max_tokens_per_rank()
+    else:
+        global_num_tokens = get_dp_global_num_tokens()
+        limit = _cake_max_tokens() if getattr(moe.experts, "mega_sm120_cake", None) is not None else _max_tokens_per_rank()
+        use = bool(global_num_tokens) and max(global_num_tokens) <= limit
+    key = (use, moe.experts.num_experts)
+    if key not in _LOGGED:  # once per process, path and MoE shape
+        _LOGGED.add(key)
+        logger.info("SM120 MegaMoE: first call on the %s path (%d experts, %d local tokens)",
+                    "mega kernel" if use else "configured MoE", moe.experts.num_experts, hidden_states.shape[0])
+    return use
+
+
+def _ue8m0_bytes(scale: torch.Tensor) -> torch.Tensor:
+    # SGLang keeps the UE8M0 block scales as e8m0 bytes, or as fp32 powers of two
+    if scale.dtype == torch.float32:
+        return ((scale.view(torch.int32) >> 23) & 0xFF).to(torch.uint8)
+    assert scale.element_size() == 1, scale.dtype
+    return scale.view(torch.uint8)
+
+
+def build_sm120_mega_moe_scales(experts, w13_up_first: bool) -> None:
+    """At load, from the checkpoint's scales (before another backend rearranges them): the kernel's scale copy.
+    `w13_up_first`: W13 holds the up rows first (FlashInfer CUTLASS loads it that way)."""
+    if getattr(experts, "_mega_moe_weights_built", False):
+        return
+    _SLOTS.setdefault((experts.num_experts, experts.top_k), len(_SLOTS))
+    fp4 = sm120_fp4()
+    w13, w2 = experts.w13_weight.data, experts.w2_weight.data
+    s13 = _ue8m0_bytes(experts.w13_weight_scale_inv.data)
+    s2 = _ue8m0_bytes(experts.w2_weight_scale_inv.data)
+    (_, ws13), (_, ws2) = fp4.transform_fp4_weights_for_mega_moe_sm120(
+        (w13.view(torch.uint8), s13), (w2.view(torch.uint8), s2), _FMT, w13_up_first
+    )
+    experts.mega_sm120_scales = (ws13, ws2)
+    experts.mega_sm120_up_first = w13_up_first
+    experts.mega_sm120_fmt = _FMT
+    if _cake_enabled() and _SLOTS[(experts.num_experts, experts.top_k)] == 0:
+        _build_cake_weights(experts, s13, s2, w13_up_first)
+    experts._mega_moe_weights_built = True
+
+
+def pack_sm120_mega_moe_weights(experts) -> None:
+    """At load, after FlashInfer's processing (SGLANG_SM120_MEGA_MOE_PACKED=1, the main model's MoE only): the weights
+    to the packed 'w4a8' layout in place (its scales are the 'w4a8_rm' + up-first ones already built), and the shared
+    row-major scratch FlashInfer's calls read, allocated now, before the KV cache takes the free memory."""
+    if os.environ.get("SGLANG_SM120_MEGA_MOE_PACKED", "0") != "1" or getattr(experts, "mega_sm120_packed", False):
+        return
+    if _SLOTS.get((experts.num_experts, experts.top_k)) != 0 or not experts.mega_sm120_up_first:
+        return
+    w13, w2 = experts.w13_weight.data.view(torch.uint8), experts.w2_weight.data.view(torch.uint8)
+    _relayout().to_packed_(w13, w2)
+    key = (tuple(w13.shape), tuple(w2.shape))
+    if key not in _SCRATCH:
+        _SCRATCH[key] = (torch.empty_like(w13), torch.empty_like(w2))
+    experts.mega_sm120_fmt = _PACKED_FMT
+    experts.mega_sm120_packed = True
+
+
+def sm120_row_major_weights(experts):
+    """FlashInfer's (W13, W2) for a call on this layer: the weights themselves, or for a packed layer its row-major
+    weights rebuilt into the shared scratch (valid until the next packed layer's call)."""
+    if not getattr(experts, "mega_sm120_packed", False):
+        return experts.w13_weight, experts.w2_weight
+    w13, w2 = experts.w13_weight.data, experts.w2_weight.data
+    s13, s2 = _SCRATCH[(tuple(w13.view(torch.uint8).shape), tuple(w2.view(torch.uint8).shape))]
+    _relayout().to_row_major(w13.view(torch.uint8), w2.view(torch.uint8), s13, s2)
+    return s13.view(w13.dtype), s2.view(w2.dtype)
+
+
+def _get_buffer(group, num_experts, num_max_tokens_per_rank, top_k, hidden, inter, fmt=_FMT):
+    key = (id(group), num_experts, num_max_tokens_per_rank, top_k, hidden, inter, fmt)
+    buf = _BUFFER.get(key)
+    if buf is None:
+        # the kernel's work-item table holds EL + W * TCAP * top-k / 8 tiles (kMaxTiles)
+        world = group.size()
+        cap = (2304 - num_experts // world) * 8 // (world * top_k)
+        if num_max_tokens_per_rank > cap:
+            raise ValueError(
+                f"SM120 MegaMoE supports at most {cap} tokens per rank here "
+                f"(EP{world}, {num_experts} experts, top-{top_k}); set "
+                "SGLANG_OPT_DEEPGEMM_MEGA_MOE_NUM_MAX_TOKENS_PER_RANK to at most "
+                f"{cap} (now {num_max_tokens_per_rank})."
+            )
+        # p2p (default) or an NCCL-window transport of sm120_fp4.TRANSPORTS (e.g. lsa_where_reachable on CX8aaS hosts)
+        transport = os.environ.get("SGLANG_SM120_MEGA_MOE_TRANSPORT", "p2p")
+        slot = _SLOTS[num_experts, top_k]
+        logger.info("SM120 MegaMoE buffer: EP%d, %d experts / top-%d (slot %d), transport %s, format %s",
+                    world, num_experts, top_k, slot, transport, fmt)
+        buf = sm120_fp4().Sm120Fp4MegaMoeBuffer(
+            group, fmt, num_experts, num_max_tokens_per_rank, top_k, hidden, inter, transport=transport, slot=slot
+        )
+        _BUFFER[key] = buf
+    return buf
+
+
+def run_sm120_mega_routed(
+    experts,
+    hidden_states: torch.Tensor,
+    topk_ids: torch.Tensor,
+    topk_weights: torch.Tensor,
+    ep_group,
+    num_tokens: int,
+    *,
+    hidden_size: int,
+    intermediate_size: int,
+    top_k: int,
+    activation_clamp: Optional[float],
+    routed_scaling_factor: float,
+    router: Optional[dict] = None,
+) -> torch.Tensor:
+    if router is not None:  # the kernel routes: topk_ids / topk_weights are its outputs
+        topk_ids = hidden_states.new_empty((num_tokens, top_k), dtype=torch.int32)
+        topk_weights = hidden_states.new_empty((num_tokens, top_k), dtype=torch.float32)
+    elif getattr(experts, "mega_sm120_cake", None) is not None:
+        from sglang.srt.layers.dp_attention import get_dp_global_num_tokens
+        from sglang.srt.model_executor.runner import get_is_capture_mode
+
+        if _cake_all() or (not get_is_capture_mode() and max(get_dp_global_num_tokens()) > _max_tokens_per_rank()):
+            assert activation_clamp == 10, activation_clamp  # the Cake build clamps SwiGLU at 10
+            y = _run_cake(experts, hidden_states, topk_ids, topk_weights, ep_group, num_tokens, top_k)
+            if routed_scaling_factor != 1.0:
+                y.mul_(routed_scaling_factor)
+            return y
+    buf = _get_buffer(
+        ep_group,
+        experts.num_experts,
+        _max_tokens_per_rank(),
+        top_k,
+        hidden_size,
+        intermediate_size,
+        experts.mega_sm120_fmt,
+    )
+    y = torch.empty(
+        (max(num_tokens, 1), hidden_size),
+        dtype=torch.bfloat16,
+        device=hidden_states.device,
+    )
+    ws13, ws2 = experts.mega_sm120_scales
+    sm120_fp4().fp4_mega_moe_sm120(
+        y[:num_tokens],
+        hidden_states[:num_tokens],
+        topk_ids,
+        topk_weights,
+        (experts.w13_weight.data, ws13),
+        (experts.w2_weight.data, ws2),
+        buf,
+        activation_clamp=activation_clamp,
+        w13_up_first=experts.mega_sm120_up_first and experts.mega_sm120_fmt == _FMT,
+        **(router or {}),
+    )
+    y = y[:num_tokens]
+    if routed_scaling_factor != 1.0:
+        y.mul_(routed_scaling_factor)
+    return y
